# ==============================================================================
# Run — Production Environment Configuration
# Copy this file to .env and configure the variables for your deployment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Authoritative Database (Turso / LibSQL)
# ------------------------------------------------------------------------------
# Production remote database (Turso):
DATABASE_URL="libsql://your-database-name.turso.io"
DATABASE_AUTH_TOKEN="your-turso-auth-token"

# For local development:
# DATABASE_URL="file:local.db"
# DATABASE_AUTH_TOKEN=""

# ------------------------------------------------------------------------------
# 2. Authentication & Site Security (Better Auth & Edge HMAC)
# ------------------------------------------------------------------------------
# Full public URL of your application instance (e.g., https://go.run.link)
ORIGIN="http://localhost:5173"

# Better Auth encryption secret (32+ characters, generated with high entropy)
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="generate-a-secure-32-char-secret-here"

# Edge security salt used for HMAC-SHA256 age verification & link signing
SITE_TOKEN="generate-a-secure-random-site-token-here"

# Vercel Cron authorization secret (matches Authorization: Bearer <CRON_SECRET>)
CRON_SECRET="your-secure-cron-secret-token"

# ------------------------------------------------------------------------------
# 3. Fast Read Cache (Redis / Vercel KV / Upstash) [Recommended for <10ms edge]
# ------------------------------------------------------------------------------
# Option A: Standard TCP Redis (Redis Cloud, AWS ElastiCache, Self-Hosted Docker)
# e.g., REDIS_URL="redis://default:password@host.db.redis.io:18768"
REDIS_URL=""

# Option B: Upstash HTTP REST Redis (Vercel KV)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ------------------------------------------------------------------------------
# 4. Automated Database Backups (Vercel Blob) [Optional]
# ------------------------------------------------------------------------------
# Automatically configured when deploying Vercel Blob store
BLOB_READ_WRITE_TOKEN=""

# ------------------------------------------------------------------------------
# 5. AI Slug & Metadata Suggestions (Google Gemini) [Optional]
# ------------------------------------------------------------------------------
# Obtain from Google AI Studio: https://aistudio.google.com/
GOOGLE_GENERATIVE_AI_API_KEY=""

# ------------------------------------------------------------------------------
# 6. High-Volume Analytics Engine (Tinybird / ClickHouse) [Optional]
# ------------------------------------------------------------------------------
# Leave empty to use built-in SQLite/Turso analytics aggregation
TINYBIRD_API_URL=""
TINYBIRD_TOKEN=""
